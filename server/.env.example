# Chép thành server/.env để chạy máy local với Supabase. Bỏ trống tất cả = dùng Postgres nhúng (PGlite) + ổ đĩa trong server/data.

# Supabase → Connect → Session pooler (port 5432)
DATABASE_URL=
# File chứng chỉ SSL tải từ Supabase → Database Settings → SSL Configuration
DATABASE_CA=
# https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase → Settings → API Keys → Secret key (sb_secret_...). Không bao giờ đưa key này lên client.
SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=floral-uploads

# Tùy chọn
GEMINI_API_KEY=
# PORT=3000
# HOST=127.0.0.1
