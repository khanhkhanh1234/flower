PORT=3000
# Path to SQLite file (default: server/data/shop.db)
# DB_PATH=./data/shop.db

# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Admin login password (at least 8 characters)
ADMIN_PASSWORD=

# Set to 1 when running behind a reverse proxy (nginx, Caddy...)
# TRUST_PROXY=1
